# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# TMDB → Settings → API → API Read Access Token (Bearer)
TMDB_API_TOKEN=

# Solo desarrollo local (nunca true en producción)
DEV_SKIP_AUTH=false
NEXT_PUBLIC_DEV_SKIP_AUTH=false

# Fase 6 — worker async (service role, solo servidor; nunca exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=

# Fase 6 — Inngest (opcional; sin esto se usa after() en el mismo proceso)
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=

# Fase 6 — Upstash Redis cache TMDB (opcional)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Fase 6 — pgvector en carriles (false para desactivar)
ENABLE_PGVECTOR=true
